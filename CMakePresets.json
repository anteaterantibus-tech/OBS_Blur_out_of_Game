{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "template",
      "hidden": true,
      "cacheVariables": { "ENABLE_FRONTEND_API": false, "ENABLE_QT": false }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (VS 2022)",
      "description": "Build for Windows x64",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.22621",
      "warnings": { "dev": true, "deprecated": true }
    },
    {
      "name": "windows-x64-local",
      "displayName": "Windows x64 local (VS 2026 + SDK 10.0.26100)",
      "description": "Local build with installed VS BuildTools 18 and Windows SDK 10.0.26100",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.26100.0",
      "warnings": { "dev": true, "deprecated": true }
    },
    {
      "name": "windows-ci-x64",
      "inherits": ["windows-x64"],
      "displayName": "Windows x64 CI build",
      "cacheVariables": { "CMAKE_COMPILE_WARNING_AS_ERROR": true }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-local",
      "configurePreset": "windows-x64-local",
      "displayName": "Windows x64 local",
      "configuration": "RelWithDebInfo"
    }
  ]
}
